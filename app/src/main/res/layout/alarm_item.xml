<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginBottom="8dp">

    <!-- Texto de la alarma -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/alarm_text_background"
        android:padding="8dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/alarm_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Alarma configurada"
            android:textColor="@color/neutral_gray_contrast"
            android:textSize="12dp" />
    </LinearLayout>

    <!-- Botón para detener alarma -->
    <ImageButton
        android:id="@+id/button_stop_alarm"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/button_background"
        android:src="@drawable/ic_arrow"
        android:contentDescription="Detener alarma" />

    <!-- Botón de eliminar alarma -->
    <ImageButton
        android:id="@+id/button_delete_alarm"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/button_background"
        android:src="@drawable/ic_trash"
        android:contentDescription="Eliminar alarma" />

</LinearLayout>
